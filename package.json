{
  "name": "ecom-visual-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:desktop": "tsc -b && vite build --outDir desktop_assets",
    "desktop:dev": "wails dev",
    "desktop:build": "scripts/package-macos.sh",
    "desktop:build:macos": "scripts/package-macos.sh",
    "desktop:build:windows": "scripts/package-windows.sh",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,scss,md}\"",
    "test": "vitest run"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "lucide-react": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-router-dom": "latest",
    "zustand": "latest"
  },
  "devDependencies": {
    "@tailwindcss/vite": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "latest",
    "prettier": "^3.6.2",
    "vite": "latest",
    "vitest": "latest",
    "tailwindcss": "latest"
  }
}
